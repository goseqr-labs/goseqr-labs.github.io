---
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero-pic.png";
import Section from "./Section.astro";
---

<Section id="home">
  <div
    class="grid grid-cols-1 grid-template md:grid-cols-2 md:grid-rows-1 mt-[135px]"
  >
    <div class="flex flex-col w-full lg:w-[66.5%] pt-2">
      <h1>Built-in Trust. Backed by Compliance.<br />Secured by Design.</h1>
    </div>
    <picture class="row-span-1 md:row-span-3">
      <Image src={HeroIlust} alt="Hero Ilustration" loading="eager" />
    </picture>
    <div class="w-full lg:w-[66.5%]">
      <p class="my-[35px]">
           Your trusted partner in meeting global standards for privacy, functional safety, and cybersecurity.
      </p>
      <button class="btn-primary w-full md:w-auto">Book a Consultation</button>
    </div>
  </div>
</Section>
<style>
  .grid-template {
    grid-template-rows: auto 1fr;
  }
</style>
