---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import Section from "./Section.astro";

import propImg from "../../assets/pics/proposal-pic.png";
---

<Section>
  <Card>
    <div
      class="w-full flex justify-center items-center bg-[#F3F3F3] rounded-[45px] p-[60px] relative mt-[123px] mb-[163px]"
    >
      <div class="w-full md:w-[60%] flex flex-col gap-[26px] text-center items-center">
        <h2>Driving Compliance and Security Forward</h2>
         <p>
          Stay ahead in privacy, safety, and cybersecurity compliance with GoSeqr's advanced engineering solutions, that align effortlessly with industry standards.
        </p>
        <button class="btn-primary">Get your proposal</button>
      </div>
    </div>
  </Card>
</Section>
