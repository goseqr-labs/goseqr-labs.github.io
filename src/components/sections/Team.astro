---
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";
import decorForm from "../../assets/pics/proposal-pic.png";
import { Image } from "astro:assets";

const description =
  "GoSeqr by Goismo, delivers advanced engineering solutions designed to simplify and strengthen compliance across privacy, functional safety, and cybersecurity.\nBuilt with deep expertise in both automotive and IT domains, GoSeqr helps organizations confidently align with global standards like GDPR, ISO 26262, and ISO 21434. Its flexible architecture integrates seamlessly into existing systems and workflows — making complex compliance more manageable, measurable, and actionable.\n\nWhether you're launching a new mobility product or upgrading your data protection framework, GoSeqr brings clarity, structure, and trust to every stage of your compliance journey.";

---
<Section id="about">
  <div class="mb-[140px] flex flex-col lg:flex-row items-start gap-10 bg-[#F3F3F3] rounded-[45px] p-[40px] relative">
    <!-- Left Side: About Us Description -->
    <div class="lg:w-3/4 flex flex-col justify-center">
      <SectionTitle sectionTitle="About Us" description={description} />
    </div>
    <!-- Right Side: Image Display -->
    <div class="lg:w-1/3 flex justify-end hidden lg:flex">
      <Image src={decorForm} alt="Decorative Image" class="w-full h-auto object-cover" />
    </div>
    <!-- Responsive Image for Smaller Screens -->
    <div class="lg:hidden w-full flex justify-center">
      <Image src={decorForm} alt="Decorative Image" class="w-3/4 h-auto object-cover" />
    </div>
  </div>
</Section>
